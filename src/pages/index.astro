---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config.js';

const roundups = (await getCollection('roundups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="wrap intro">
    <h1>Outfit edits<br />worth saving.</h1>
    <p class="prose intro__lede">{SITE.description}</p>
  </section>

  <section class="wrap">
    <ul class="feed" role="list">
      {roundups.map((entry, i) => (
        <li class="feed__item">
          <a class="feed__link" href={`/${entry.id}/`}>
            <div class="feed__frame">
              <Picture
                src={entry.data.pinImage}
                alt={entry.data.pinAlt}
                widths={[320, 480, 640]}
                sizes="(min-width: 900px) 300px, (min-width: 600px) 44vw, 90vw"
                formats={['avif', 'webp']}
                quality={72}
                loading={i < 2 ? 'eager' : 'lazy'}
                class="feed__img"
              />
            </div>
            <p class="eyebrow feed__count">{entry.data.products.length} picks</p>
            <h2 class="feed__title">{entry.data.title}</h2>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: clamp(3rem, 2rem + 5vw, 6rem) 1rem; }
  .intro__lede { margin-top: 1.2rem; font-size: var(--step-1); color: var(--ink-soft); }

  .feed {
    list-style: none;
    padding: 0;
    margin-top: 3rem;
    display: grid;
    gap: 2.5rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }

  .feed__link { text-decoration: none; display: block; }

  .feed__frame {
    aspect-ratio: 2 / 3;
    background: var(--shell);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .feed__img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 480ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .feed__link:hover .feed__img { transform: scale(1.035); }

  .feed__count { margin-top: 0.9rem; }

  .feed__title {
    margin-top: 0.35rem;
    font-size: var(--step-1);
    font-variation-settings: 'SOFT' 20, 'WONK' 1, 'opsz' 40;
  }

  .feed__link:hover .feed__title { text-decoration: underline; text-decoration-thickness: 1px; }
</style>
