---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/karla';
import '../styles/global.css';
import { SITE } from '../config.js';

interface Props {
  title: string;
  description: string;
  /** Absolute or resolved URL of the social/pin image for this page. */
  ogImage?: string;
  /** Page-specific JSON-LD, already stringified by the caller. */
  jsonLd?: string;
}

const { title, description, ogImage, jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Tells Pinterest this page is a rich-pin source rather than a bare link. */}
    <meta name="pinterest-rich-pin" content="true" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="wordmark" href="/">{SITE.name}</a>
        <p class="masthead__tag">{SITE.tagline}</p>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer__brand">{SITE.name}</p>
        <p class="footer__legal">
          As an Amazon Associate I earn from qualifying purchases.
          &copy; {new Date().getFullYear()} {SITE.name}.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0.75rem 1rem;
    z-index: 10;
  }
  .skip:focus { left: 0; }

  .masthead {
    border-bottom: 1px solid var(--blush);
    padding-block: 1.1rem;
  }
  .masthead__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .wordmark {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 20, 'WONK' 1, 'opsz' 40;
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .masthead__tag {
    font-size: var(--step--1);
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }

  .footer {
    margin-top: 5rem;
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--blush);
    background: var(--shell);
  }
  .footer__brand {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 20, 'WONK' 1;
    font-size: var(--step-1);
  }
  .footer__legal {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
</style>
