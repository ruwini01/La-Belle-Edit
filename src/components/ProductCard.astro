---
import { Picture } from 'astro:assets';
import { affiliateUrl } from '../utils/affiliate.js';
import { SITE } from '../config.js';

interface Props {
  product: {
    name: string;
    note?: string;
    image: ImageMetadata;
    alt: string;
    url: string;
  };
  /** 1-based position in the edit. Drives the numeral and the load priority. */
  index: number;
  /** Canonical URL of the host page — Pinterest needs it to build the pin. */
  pageUrl: string;
}

const { product, index, pageUrl } = Astro.props;

const href = affiliateUrl(product.url);

// The first row is above the fold on every breakpoint. Those load eagerly and
// get a high fetch priority; everything after is lazy so a 30-image page
// still hits Largest Contentful Paint on the first card alone.
const isAboveFold = index <= 3;

// Pinterest's official share endpoint. No third-party script needed — a plain
// link with three query params opens the same pin composer.
const pinHref =
  'https://pinterest.com/pin/create/button/?' +
  new URLSearchParams({
    url: pageUrl,
    media: new URL(product.image.src, SITE.url).href,
    description: `${product.name} — ${SITE.name}`,
  }).toString();
---

<article class="card">
  <div class="card__frame">
    <Picture
      src={product.image}
      alt={product.alt}
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1000px) 340px, (min-width: 640px) 46vw, 92vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      quality={72}
      loading={isAboveFold ? 'eager' : 'lazy'}
      decoding={isAboveFold ? 'sync' : 'async'}
      fetchpriority={isAboveFold ? 'high' : 'auto'}
      class="card__img"
    />

    <span class="card__index" aria-hidden="true">
      {String(index).padStart(2, '0')}
    </span>

    <a class="card__pin" href={pinHref} target="_blank" rel="noopener nofollow">
      Save<span class="visually-hidden"> {product.name} to Pinterest</span>
    </a>
  </div>

  <div class="card__body">
    <h2 class="card__name">{product.name}</h2>
    {product.note && <p class="card__note">{product.note}</p>}

    <a class="card__cta" href={href} target="_blank" rel="sponsored nofollow noopener">
      Shop on Amazon
      <span class="visually-hidden"> — {product.name} (opens in a new tab)</span>
      <svg class="card__arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .card__frame {
    position: relative;
    background: var(--shell);
    border-radius: var(--radius);
    overflow: hidden;
    /* Portrait crop. Fashion reads better tall, and it matches the pin ratio. */
    aspect-ratio: 3 / 4;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 480ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card:hover .card__img { transform: scale(1.035); }

  /* The signature: an oversized numeral bleeding off the frame's bottom edge,
     half-behind the image well, so the count is felt while scrolling. */
  .card__index {
    position: absolute;
    left: -0.06em;
    bottom: -0.34em;
    font-family: var(--display);
    font-variation-settings: 'SOFT' 20, 'WONK' 1, 'opsz' 144;
    font-weight: 500;
    font-size: clamp(4.5rem, 3rem + 7vw, 7rem);
    line-height: 1;
    color: var(--paper);
    mix-blend-mode: difference;
    opacity: 0.92;
    pointer-events: none;
    user-select: none;
  }

  .card__pin {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--paper);
    color: var(--ink);
    font-size: var(--step--1);
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  /* Touch devices have no hover, so the save button is always visible there. */
  .card:hover .card__pin,
  .card__pin:focus-visible { opacity: 1; }

  @media (hover: none) {
    .card__pin { opacity: 1; }
  }

  .card__body {
    padding-top: 0.95rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__name {
    font-family: var(--body);
    font-size: var(--step-0);
    font-variation-settings: 'wght' 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .card__note {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .card__cta {
    margin-top: auto;
    padding-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    font-size: var(--step--1);
    font-variation-settings: 'wght' 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--wine);
    text-decoration: none;
    border-bottom: 1.5px solid var(--wine);
    padding-bottom: 2px;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .card__cta:hover { color: var(--wine-deep); border-color: var(--wine-deep); }

  .card__arrow { transition: transform 200ms ease; }
  .card__cta:hover .card__arrow { transform: translateX(3px); }
</style>
